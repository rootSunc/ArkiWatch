NODE_ENV=production
NEXT_PUBLIC_APP_NAME=ArkiWatch
NEXT_PUBLIC_API_BASE_URL=https://api.arkiwatch.example.com/api
# Read by the server at request time and embedded into the browser runtime
# config; do not rely on NEXT_PUBLIC_* being changed after `next build`.
API_PUBLIC_BASE_URL=https://api.arkiwatch.example.com/api
API_INTERNAL_BASE_URL=http://api:8000/api
NEXT_PUBLIC_DEFAULT_USER_ID=
APP_TIMEZONE=Europe/Helsinki
