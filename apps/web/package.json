{
  "name": "@arkiwatch/web",
  "version": "1.2.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "generate:api-types": "openapi-typescript ../../apps/api/openapi.json -o src/lib/api-contract.ts",
    "check": "pnpm run lint && pnpm run test && pnpm run typecheck && pnpm run audit:i18n",
    "audit:i18n": "node scripts/audit-legacy-i18n.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "leaflet": "^1.9.4",
    "next": "^15.5.23",
    "next-intl": "^4.13.2",
    "proj4": "^2.20.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.23",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.7"
  }
}
