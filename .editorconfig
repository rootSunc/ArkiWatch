root = true

[*.{js,jsx,ts,tsx}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt owns Go formatting (tabs); this just keeps line endings consistent.
[*.go]
end_of_line = lf
insert_final_newline = true

[Makefile]
indent_style = tab
